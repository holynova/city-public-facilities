{
  "name": "city-public-facilities",
  "version": "0.1.0",
  "description": "城市公共地点近邻检索",
  "private": true,
  "homepage": "https://holynova.github.io/city-public-facilities/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holynova/city-public-facilities.git"
  },
  "bugs": {
    "url": "https://github.com/holynova/city-public-facilities/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "build": "tsc --outDir .build && node scripts/build-static.mjs",
    "build:pages": "pnpm run build && node scripts/build-pages.mjs",
    "import:beijing-metro": "node scripts/import-beijing-metro.mjs",
    "cli": "pnpm run build && node .build/cli.js",
    "web": "pnpm run build && node .build/web/server.js",
    "check:env": "pnpm run build && node .build/cli.js check-env",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
